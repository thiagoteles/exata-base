                  },
                  {
                    "group": ["@/lib/ports/*/adapters/**"],
                    "message": "Adapters are loaded by their port. Import the port, not the adapter."
                  },
                  {
                    "group": ["@/app/**", "@/components/**", "@/features/**"],
                    "message": "lib is the lowest layer: it does not import app, components or features."
                  },
                  {
                    "group": ["zod", "zod/**"],
                    "message": "Import z from @/lib/validation, which turns every issue into a catalog key."
